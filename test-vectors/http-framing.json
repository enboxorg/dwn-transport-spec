{
  "suite": "dwn-transport-spec/http-framing",
  "spec": "https://dwn-transport-spec.pages.dev#request-framing",
  "mediaType": "application/vnd.enbox.dwn-rpc",
  "description": "Binary HTTP request framing vectors (1-byte flags, 4-byte big-endian envelope length, UTF-8 JSON-RPC envelope, optional trailing raw data bytes) and Content-Type matching.",
  "contentTypes": [
    {
      "value": "application/vnd.enbox.dwn-rpc",
      "expectedValid": true
    },
    {
      "value": "APPLICATION/VND.ENBOX.DWN-RPC",
      "expectedValid": true
    },
    {
      "value": "  application/vnd.enbox.dwn-rpc  ",
      "expectedValid": true
    },
    {
      "value": "application/vnd.enbox.dwn-rpc; charset=utf-8",
      "expectedValid": false
    },
    {
      "value": "application/json",
      "expectedValid": false
    }
  ],
  "validFrames": [
