  "invalidFrames": [
    {
      "id": "invalid-flags-0x02",
      "description": "Unsupported flags byte 0x02 (only 0x00 and 0x01 allowed).",
      "frameHex": "02000000027b7d",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-envelope-length-zero",
      "description": "Envelope length 0 is invalid.",
      "frameHex": "0000000000",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-envelope-exceeds-1mib",
      "description": "Envelope length 1,048,577 (0x00100001) exceeds 1 MiB limit.",
      "frameHex": "00001000017b7d",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-truncated-header",
      "description": "Body shorter than 5-byte frame header.",
      "frameHex": "000000",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-truncated-envelope",
      "description": "Body ends before declared envelope length.",
      "frameHex": "000000000a7b7d",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-trailing-bytes-with-flag-0x00",
      "description": "Extra bytes after envelope when flags is 0x00.",
      "frameHex": "00000000027b7dff",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-non-utf8-envelope",
      "description": "Envelope contains invalid UTF-8 bytes (0xff 0xfe).",
      "frameHex": "0000000002fffe",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    },
    {
      "id": "invalid-json-envelope",
      "description": "Envelope is valid UTF-8 (\"{bad\") but not valid JSON.",
      "frameHex": "00000000047b626164",
      "expectedHttpStatus": 400,
      "expectedJsonRpcErrorCode": -50400
    }
  ]
}
